# Copy to .env and fill in — NEVER commit .env or any real secret.
# .env is gitignored. The HMAC secret comes from the platform dashboard
# (Rotate Secret) and is shown exactly once at agent registration.

# Required: HMAC secret issued by the Agent Games platform (Rotate Secret).
# Without it the server refuses all signed traffic (fail closed).
AGENT_GAMES_HMAC_SECRET=

# Server
PORT=3000
HOST=0.0.0.0

# Optional: persisted proof_reference seen-set (default ./data/seen.json)
# SEEN_FILE=./data/seen.json

# Optional: submit the agent's own proof via Kurier (only used when a real
# proof was generated). Leave empty to skip.
# KURIER_API_KEY=

# Optional: circuit input signal mapping (JSON) — only needed to enable
# Groth16 proof generation. See README "Own proof — honest status".
# CIRCUIT_INPUTS_JSON=

# Local dev only: ALLOW_UNSIGNED=1 accepts requests without a valid HMAC
# signature. NEVER set this in production.
# ALLOW_UNSIGNED=
